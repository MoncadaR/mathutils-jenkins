// Jenkinsfile (Declarative Pipeline) for a Maven Java project with:
// - Build + Unit Tests (JUnit)
// - Test report publishing
// - JaCoCo coverage publishing
// - JAR artifact archiving
// - (Optional) SonarQube static analysis + Quality Gate
// - (Optional) Email notifications
//
// Put this file at the ROOT of your GitHub repo as: Jenkinsfile

pipeline {
  agent any

  tools {
    // Configure these in Jenkins: Manage Jenkins -> Global Tool Configuration
    // If you haven't configured tools, you can remove this block and rely on system mvn/java.
    jdk 'JDK17'
    maven 'Maven3'
  }

  environment {
    // ===== Optional: SonarQube =====
    // In Jenkins: Manage Jenkins -> Configure System -> SonarQube servers
    // Set SONARQUBE_SERVER_NAME to match that configuration name (example: 'MySonar')
    SONARQUBE_SERVER_NAME = 'MySonar'
    SONAR_PROJECT_KEY     = 'mathutils'
    // If you need extra sonar properties, add SONAR_EXTRA_OPTS like:
    // SONAR_EXTRA_OPTS = '-Dsonar.organization=xxx -Dsonar.projectName=MathUtils'
    SONAR_EXTRA_OPTS      = ''

    // ===== Optional: Email notifications =====
    EMAIL_RECIPIENTS      = 'your_email@example.com'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build & Unit Tests') {
      steps {
        // Runs tests + creates JaCoCo report if jacoco-maven-plugin is in your pom.xml
        sh 'mvn -B clean verify'
      }
      post {
        always {
          // Publish JUnit test results (Surefire)
          junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'

          // Archive useful reports even if build fails
          archiveArtifacts artifacts: 'target/site/**', allowEmptyArchive: true
        }
      }
    }

    stage('Static Analysis (SonarQube)') {
      when {
        expression { return env.SONARQUBE_SERVER_NAME?.trim() }
      }
      steps {
        // Requires SonarQube Scanner for Jenkins plugin + SonarQube server configured
        withSonarQubeEnv("${SONARQUBE_SERVER_NAME}") {
          sh """
            mvn -B sonar:sonar \
              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
              ${SONAR_EXTRA_OPTS}
          """
        }
      }
    }

    stage('Quality Gate') {
      when {
        expression { return env.SONARQUBE_SERVER_NAME?.trim() }
      }
      steps {
        // Requires "Wait for Quality Gate" step (SonarQube plugin)
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Package Artifact (JAR)') {
      steps {
        sh 'mvn -B -DskipTests package'
      }
      post {
        success {
          // Archive the JAR as a build artifact
          archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
        }
      }
    }

    stage('Publish Coverage (JaCoCo)') {
      steps {
        // Requires Jenkins "JaCoCo" plugin.
        // Your pom.xml should generate either jacoco.exec or jacoco.xml (recommended).
        // This step works with exec data:
        jacoco(
          execPattern: '**/target/**/jacoco.exec',
          classPattern: '**/target/classes',
          sourcePattern: '**/src/main/java',
          exclusionPattern: '**/src/test/**'
        )
      }
    }
  }

  post {
    success {
      echo "Build SUCCESS ✅"

      // Optional Email (requires Email Extension plugin + SMTP configured)
      // emailext(
      //   to: "${EMAIL_RECIPIENTS}",
      //   subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
      //   body: "Build succeeded: ${env.BUILD_URL}"
      // )
    }

    failure {
      echo "Build FAILED ❌"

      // Optional Email (requires Email Extension plugin + SMTP configured)
      // emailext(
      //   to: "${EMAIL_RECIPIENTS}",
      //   subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
      //   body: "Build failed: ${env.BUILD_URL}"
      // )
    }

    always {
      // Helpful for debugging
      echo "Done. Build URL: ${env.BUILD_URL}"
    }
  }
}
